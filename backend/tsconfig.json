{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "outDir": "./dist"
  },
  "include": ["src/**/*"],
  "exclude": [
    "./dist/**/*",
    "./node_modules/**/*",
    "*.js",
    "*.json"
  ]
}
